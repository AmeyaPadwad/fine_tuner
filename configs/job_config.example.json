{
  "job_id": "job_rlcd_smoke_test_01",
  "model": {
    "base_model_id": "laya",
    "auth_token": null
  },
  "dataset": {
    "source_path": "data/samples/toy_tool_selection.jsonl",
    "format": "decision",
    "decision_type": "choice",
    "max_seq_length": 512,
    "eval_split_ratio": 0.2
  },
  "training": {
    "epochs": 4,
    "batch_size": 8,
    "gradient_accumulation_steps": 1,
    "encoder_lr": 1e-5,
    "head_lr": 1e-4,
    "lr_scheduler_type": "cosine",
    "lr_eta_min": 1e-6,
    "reward_samples": 8,
    "sigma_init": 1.0,
    "sigma_final": 0.1,
    "w_spherical": 0.75,
    "w_rps": 1.0,
    "rl_ce_fraction": 0.5,
    "grad_clip_norm": 1.0,
    "mixed_precision": true
  },
  "output": {
    "output_dir": "outputs/rlcd_smoke_test_01",
    "save_checkpoint": true,
    "export_onnx": false,
    "logging_steps": 1
  }
}
